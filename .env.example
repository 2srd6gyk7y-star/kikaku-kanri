# ---- 必須（クラウドに置くときは必ず設定） ----
# セッションの署名キー。長いランダム文字列にする
SECRET_KEY=ここにランダムな長い文字列

# データの保存先（Postgres）。未設定ならローカルの SQLite を使う
# 例: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# ---- LINE通知（追々使う。未設定なら通知しない） ----
LINE_CHANNEL_ACCESS_TOKEN=
# 送信先のuserId/groupId。空ならブロードキャスト（友だち全員）
LINE_TO=
# 通知文の末尾に載せるツールのURL
APP_BASE_URL=
